                            previewStr = extractTextFromDocx(decryptedBytes);
                        else if (isMagicPdf(decryptedBytes))
                            previewStr = extractTextFromMinimalPdf(decryptedBytes);
                        else
                            previewStr = new String(decryptedBytes, StandardCharsets.UTF_8);

