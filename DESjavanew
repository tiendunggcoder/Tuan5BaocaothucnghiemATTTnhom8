                        Cipher cipher = Cipher.getInstance("DES/ECB/PKCS5Padding");
                        cipher.init(Cipher.DECRYPT_MODE, key);

                        byte[] decryptedBytes = cipher.doFinal(decodedBytes);
                        tempDecResultBytes = decryptedBytes;

                        String previewStr;
