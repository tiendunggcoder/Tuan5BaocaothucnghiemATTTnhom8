        } else {
            fc.setFileFilter(new FileNameExtensionFilter("Tài liệu (txt, docx, pdf)", "txt", "docx", "pdf"));
        }
        if (fc.showOpenDialog(this) == JFileChooser.APPROVE_OPTION) {
            File file = fc.getSelectedFile();
            try {
                String name = file.getName().toLowerCase();
                if (name.endsWith(".docx"))
                    textArea.setText(extractTextFromDocx(Files.readAllBytes(file.toPath())));
                else if (name.endsWith(".pdf"))
                    textArea.setText(extractTextFromMinimalPdf(Files.readAllBytes(file.toPath())));
                else
                    textArea.setText(Files.readString(file.toPath(), StandardCharsets.UTF_8));
            } catch (Exception ex) {
                JOptionPane.showMessageDialog(this, "Không thể đọc file!\nChi tiết: " + ex.getMessage(), "Lỗi",
                        JOptionPane.ERROR_MESSAGE);
            }
        }
    }

    private void loadFileToTextField(JTextField textField, JComboBox<String> cbKeyFormat) {
        JFileChooser fc = new JFileChooser();
        fc.setFileFilter(
                new FileNameExtensionFilter("Tài liệu khóa (txt, docx, pdf, key)", "txt", "docx", "pdf", "key"));
        if (fc.showOpenDialog(this) == JFileChooser.APPROVE_OPTION) {
            try {
                File file = fc.getSelectedFile();
                String name = file.getName().toLowerCase();
                String content;
                if (name.endsWith(".docx"))
                    content = extractTextFromDocx(Files.readAllBytes(file.toPath()));
                else if (name.endsWith(".pdf"))
                    content = extractTextFromMinimalPdf(Files.readAllBytes(file.toPath()));
                else
                    content = Files.readString(file.toPath(), StandardCharsets.UTF_8);

                String keyText = "";
                for (String line : content.split("\n")) {
                    if (!line.trim().isEmpty()) {
                        keyText = line.trim();
                        break; 
                    }
                }
                if (keyText.isEmpty()) keyText = content.trim();
                
                textField.setText(keyText);

                String noSpace = keyText.replaceAll("\\s+", "");
                if (noSpace.length() == 16 && noSpace.matches("^[0-9a-fA-F]+$")) {
                    cbKeyFormat.setSelectedItem("Hex (16 ký tự)");
                } else if (keyText.length() == 8) {
                    cbKeyFormat.setSelectedItem("Text (8 ký tự)");
                }

            } catch (Exception ex) {
                JOptionPane.showMessageDialog(this, "Không thể đọc file khóa.", "Lỗi", JOptionPane.ERROR_MESSAGE);
            }
        }
    }

    private void saveContentToFile(String content, String title, boolean isKey, boolean isCipher) {
        if (content.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Không có dữ liệu để lưu!", "Thông báo", JOptionPane.WARNING_MESSAGE);
            return;
        }
        JFileChooser fc = new JFileChooser();
        fc.setDialogTitle(title);
        fc.setFileFilter(new FileNameExtensionFilter("Text File (*.txt)", "txt"));
        fc.addChoosableFileFilter(new FileNameExtensionFilter("Word Document (*.docx)", "docx"));
        fc.addChoosableFileFilter(new FileNameExtensionFilter("PDF Document (*.pdf)", "pdf"));
        if (isKey)
            fc.addChoosableFileFilter(new FileNameExtensionFilter("Key File (*.key)", "key"));
        if (isCipher)
            fc.addChoosableFileFilter(new FileNameExtensionFilter("DES Encrypted (*.des)", "des"));

        if (fc.showSaveDialog(this) == JFileChooser.APPROVE_OPTION) {
            try {
                File file = fc.getSelectedFile();
                String desc = fc.getFileFilter().getDescription().toLowerCase();
                if (!file.getName().contains(".")) {
                    if (desc.contains("docx"))
                        file = new File(file.getAbsolutePath() + ".docx");
                    else if (desc.contains("pdf"))
                        file = new File(file.getAbsolutePath() + ".pdf");
                    else if (desc.contains("key"))
                        file = new File(file.getAbsolutePath() + ".key");
                    else if (desc.contains("des"))
                        file = new File(file.getAbsolutePath() + ".des");
                    else
                        file = new File(file.getAbsolutePath() + ".txt");
                }

                String ext = file.getName().substring(file.getName().lastIndexOf('.')).toLowerCase();
                if (ext.equals(".docx"))
                    writeDocx(file, content);
                else if (ext.equals(".pdf"))
                    writePdf(file, content);
                else
                    Files.writeString(file.toPath(), content, StandardCharsets.UTF_8);

                JOptionPane.showMessageDialog(this, "Lưu thành công: " + file.getName(), "Thành công",
                        JOptionPane.INFORMATION_MESSAGE);
            } catch (Exception ex) {
                JOptionPane.showMessageDialog(this, "Lỗi khi lưu file: " + ex.getMessage(), "Lỗi",
                        JOptionPane.ERROR_MESSAGE);
            }
        }
    }

    private void saveDecryptedFile() {
        if (tempDecResultBytes == null || tempDecResultBytes.length == 0) {
            JOptionPane.showMessageDialog(this, "Chưa có dữ liệu giải mã!", "Thông báo", JOptionPane.WARNING_MESSAGE);
            return;
        }
        JFileChooser fc = new JFileChooser();
        fc.setDialogTitle("Lưu kết quả giải mã");
        if (fc.showSaveDialog(this) == JFileChooser.APPROVE_OPTION) {
            try {
                File file = fc.getSelectedFile();
                if (!file.getName().contains("."))
                    file = new File(file.getAbsolutePath() + ".txt");

                if (isMagicPdf(tempDecResultBytes) || isMagicDocx(tempDecResultBytes)) {
                    Files.write(file.toPath(), tempDecResultBytes);
                } else {
                    String content = new String(tempDecResultBytes, StandardCharsets.UTF_8);
                    String ext = file.getName().substring(file.getName().lastIndexOf('.')).toLowerCase();
                    if (ext.equals(".docx"))
                        writeDocx(file, content);
                    else if (ext.equals(".pdf"))
                        writePdf(file, content);
                    else
                        Files.writeString(file.toPath(), content, StandardCharsets.UTF_8);
                }
                JOptionPane.showMessageDialog(this, "Lưu thành công: " + file.getName(), "Thành công",
                        JOptionPane.INFORMATION_MESSAGE);
            } catch (Exception ex) {
                JOptionPane.showMessageDialog(this, "Lỗi khi lưu file: " + ex.getMessage(), "Lỗi",
                        JOptionPane.ERROR_MESSAGE);
            }
        }
    }

    private boolean isMagicPdf(byte[] b) {
        return b.length >= 4 && b[0] == '%' && b[1] == 'P' && b[2] == 'D' && b[3] == 'F';
    }

    private boolean isMagicDocx(byte[] b) {
        return b.length >= 4 && b[0] == 'P' && b[1] == 'K' && b[2] == 0x03 && b[3] == 0x04;
    }

    private String extractTextFromDocx(byte[] data) {
        if (!isMagicDocx(data)) {
            return new String(data, StandardCharsets.UTF_8);
        }
        try (ZipInputStream zis = new ZipInputStream(new ByteArrayInputStream(data))) {
            ZipEntry entry;
            while ((entry = zis.getNextEntry()) != null) {
                if (entry.getName().equals("word/document.xml")) {
                    try (Scanner sc = new Scanner(zis, StandardCharsets.UTF_8).useDelimiter("\\A")) {
                        return sc.hasNext() ? sc.next().replaceAll("</w:p>", "\n").replaceAll("<[^>]+>", "").trim()
                                : "";
                    }
                }
            }
        } catch (Exception ignored) {
        }
        return new String(data, StandardCharsets.UTF_8);
    }

    private String extractTextFromMinimalPdf(byte[] rawBytes) {
        if (!isMagicPdf(rawBytes)) {
            return new String(rawBytes, StandardCharsets.UTF_8);
        }
        try {
            String raw = new String(rawBytes, StandardCharsets.ISO_8859_1);
            StringBuilder result = new StringBuilder();
            java.util.regex.Matcher hexM = java.util.regex.Pattern.compile("<([0-9A-Fa-f]+)>\\s*Tj").matcher(raw);
            boolean foundHex = false;
            while (hexM.find()) {
                String hex = hexM.group(1);
                if (hex.toUpperCase().startsWith("FEFF"))
                    hex = hex.substring(4);
                StringBuilder line = new StringBuilder();
                for (int i = 0; i + 3 < hex.length(); i += 4) {
                    try {
                        int cp = Integer.parseInt(hex.substring(i, i + 4), 16);
                        if (cp >= 32)
                            line.appendCodePoint(cp);
                    } catch (Exception ignore) {
                    }
                }
                result.append(line).append("\n");
                foundHex = true;
            }
            if (!foundHex) {
                java.util.regex.Matcher ascM = java.util.regex.Pattern.compile("\\(([^)]*)\\)\\s*Tj").matcher(raw);
                while (ascM.find())
                    result.append(ascM.group(1).replace("\\(", "(").replace("\\)", ")").replace("\\\\", "\\"))
                            .append("\n");
            }
            String out = result.toString().trim();
            return out.isEmpty() ? new String(rawBytes, StandardCharsets.UTF_8) : out;
        } catch (Exception e) {
            return new String(rawBytes, StandardCharsets.UTF_8);
        }
    }

    private void writeDocx(File file, String content) throws Exception {
        String safe = content.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;");
        StringBuilder p = new StringBuilder();
        for (String line : safe.split("\n", -1))
            p.append("<w:p><w:r><w:t xml:space=\"preserve\">").append(line).append("</w:t></w:r></w:p>\n");
        String docXml = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n<w:document xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">\n<w:body>\n"
                + p + "</w:body>\n</w:document>";
        String relsXml = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">\n<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"word/document.xml\"/>\n</Relationships>";
        String ctXml = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">\n<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>\n<Default Extension=\"xml\" ContentType=\"application/xml\"/>\n<Override PartName=\"/word/document.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml\"/>\n</Types>";

        try (ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(file))) {
            zos.putNextEntry(new ZipEntry("[Content_Types].xml"));
            zos.write(ctXml.getBytes(StandardCharsets.UTF_8));
            zos.closeEntry();
            zos.putNextEntry(new ZipEntry("_rels/.rels"));
            zos.write(relsXml.getBytes(StandardCharsets.UTF_8));
            zos.closeEntry();
            zos.putNextEntry(new ZipEntry("word/document.xml"));
            zos.write(docXml.getBytes(StandardCharsets.UTF_8));
            zos.closeEntry();
        }
    }

    private void writePdf(File file, String content) throws Exception {
        String[] lines = content.split("\n", -1);
        int lpp = 45, pageCount = Math.max(1, (int) Math.ceil((double) lines.length / lpp));
        String[][] pageLines = new String[pageCount][];
        for (int p = 0; p < pageCount; p++)
            pageLines[p] = Arrays.copyOfRange(lines, p * lpp, Math.min(p * lpp + lpp, lines.length));

        java.util.Set<Character> cs = new java.util.LinkedHashSet<>();
        cs.add(' ');
        for (char c : content.toCharArray())
            if (c >= 32)
                cs.add(c);
        StringBuilder cmap = new StringBuilder("/CIDInit /ProcSet findresource begin\n12 dict begin\nbegincmap\n" +
                "/CIDSystemInfo << /Registry (Adobe) /Ordering (UCS) /Supplement 0 >> def\n" +
                "/CMapName /Adobe-Identity-UCS def\n/CMapType 2 def\n1 begincodespacerange\n<0000> <FFFF>\nendcodespacerange\n"
                +
                cs.size() + " beginbfchar\n");
        for (char c : cs)
            cmap.append(String.format("<%04X> <%04X>\n", (int) c, (int) c));
        cmap.append("endbfchar\nendcmap\nCMapName currentdict /CMap defineresource pop\nend\nend\n");
        byte[] cmapB = cmap.toString().getBytes(StandardCharsets.UTF_8);

        int fpObj = 5, fcObj = fpObj + pageCount, total = fcObj + pageCount;
        long[] off = new long[total];
        ByteArrayOutputStream buf = new ByteArrayOutputStream();
        byte[] hdr = "%PDF-1.4\n%\u00e2\u00e3\u00cf\u00d3\n".getBytes(StandardCharsets.ISO_8859_1);
        buf.write(hdr);
        long pos = hdr.length;
        String s;

        off[0] = pos;
        s = "1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n";
        buf.write(s.getBytes(StandardCharsets.UTF_8));
        pos += s.length();
        off[1] = pos;
        StringBuilder kids = new StringBuilder("[");
        for (int i = 0; i < pageCount; i++)
            kids.append(fpObj + i).append(" 0 R ");
        kids.append("]");
        s = "2 0 obj\n<< /Type /Pages /Kids " + kids + " /Count " + pageCount + " >>\nendobj\n";
        buf.write(s.getBytes(StandardCharsets.UTF_8));
        pos += s.length();
        off[3] = pos;
        s = "4 0 obj\n<< /Length " + cmapB.length + " >>\nstream\n";
        buf.write(s.getBytes(StandardCharsets.UTF_8));
        pos += s.length();
        buf.write(cmapB);
        pos += cmapB.length;
        s = "\nendstream\nendobj\n";
        buf.write(s.getBytes(StandardCharsets.UTF_8));
        pos += s.length();
        off[2] = pos;
        s = "3 0 obj\n<< /Type /Font\n   /Subtype /Type0\n   /BaseFont /Arial\n   /Encoding /Identity-H\n   /ToUnicode 4 0 R\n   /DescendantFonts [<< /Type /Font /Subtype /CIDFontType2 /BaseFont /Arial /CIDSystemInfo << /Registry (Adobe) /Ordering (Identity) /Supplement 0 >> /DW 1000 >>]\n>>\nendobj\n";
        buf.write(s.getBytes(StandardCharsets.UTF_8));
        pos += s.length();
        for (int p = 0; p < pageCount; p++) {
            int o = fpObj + p, c = fcObj + p;
            off[o - 1] = pos;
            s = o + " 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Contents " + c
                    + " 0 R /Resources << /Font << /F1 3 0 R >> >> >>\nendobj\n";
            buf.write(s.getBytes(StandardCharsets.UTF_8));
            pos += s.length();
        }
        for (int p = 0; p < pageCount; p++) {
            int o = fcObj + p;
            off[o - 1] = pos;
            StringBuilder st = new StringBuilder("BT\n/F1 12 Tf\n14 TL\n50 810 Td\n");
            for (String ln : pageLines[p]) {
                byte[] u = ln.getBytes(java.nio.charset.Charset.forName("UTF-16BE"));
                StringBuilder hex = new StringBuilder("<FEFF");
                for (byte b2 : u)
                    hex.append(String.format("%02X", b2 & 0xFF));
                hex.append(">");
                st.append(hex).append(" Tj\nT*\n");
            }
            st.append("ET\n");
            byte[] sb = st.toString().getBytes(StandardCharsets.UTF_8);
            s = o + " 0 obj\n<< /Length " + sb.length + " >>\nstream\n";
            buf.write(s.getBytes(StandardCharsets.UTF_8));
            pos += s.length();
            buf.write(sb);
            pos += sb.length;
            s = "\nendstream\nendobj\n";
            buf.write(s.getBytes(StandardCharsets.UTF_8));
            pos += s.length();
        }
        long xr = pos;
        StringBuilder x = new StringBuilder("xref\n0 " + (total + 1) + "\n0000000000 65535 f \n");
        for (long o : off)
            x.append(String.format("%010d 00000 n \n", o));
        x.append("trailer\n<< /Size ").append(total + 1).append(" /Root 1 0 R >>\nstartxref\n").append(xr)
                .append("\n%%EOF\n");
        buf.write(x.toString().getBytes(StandardCharsets.UTF_8));
        Files.write(file.toPath(), buf.toByteArray());
    }

