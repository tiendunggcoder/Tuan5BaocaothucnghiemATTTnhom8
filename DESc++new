void DrawCard(HDC hdc, int x, int y, int w, int h, COLORREF borderColor) {
    // 1. Ve do bong nhe
    RECT shadow = {x+2, y+2, x+w+2, y+h+2};
    HBRUSH hShad = CreateSolidBrush(RGB(210, 215, 225));
    FillRect(hdc, &shadow, hShad);
    DeleteObject(hShad);

    // 2. Ve Card mau trang co bo tron
    HPEN hPen = CreatePen(PS_SOLID, 1, borderColor);
    HBRUSH hBrush = CreateSolidBrush(CLR_WHITE);
    HGDIOBJ oldP = SelectObject(hdc, hPen);
    HGDIOBJ oldB = SelectObject(hdc, hBrush);
    RoundRect(hdc, x, y, x+w, y+h, 24, 24); // Bo goc 24px
    SelectObject(hdc, oldP);
    SelectObject(hdc, oldB);
    DeleteObject(hPen);
    DeleteObject(hBrush);
}

void PaintPanel(HWND hwnd, COLORREF bg, const char* title, COLORREF titleClr) {
    PAINTSTRUCT ps; HDC hdc = BeginPaint(hwnd, &ps);
    RECT rc; GetClientRect(hwnd, &rc);
    
    // Nhan ban mau nen
    HBRUSH br = CreateSolidBrush(bg); FillRect(hdc, &rc, br); DeleteObject(br);
    
    // Ve giao dien dang Card
    int w = rc.right - 40; // Le hai ben 20px
    DrawCard(hdc, 20, 50, w, 160, titleClr);              // Card 1: Input
    DrawCard(hdc, 20, 225, w, 125, titleClr);             // Card 2: Settings
    DrawCard(hdc, 20, 365, w, rc.bottom - 385, titleClr); // Card 3: Output

    // Ve tieu de
    SetBkMode(hdc, TRANSPARENT);
    SetTextColor(hdc, titleClr);
    SelectObject(hdc, hFTitle);
    RECT tr = {0, 10, rc.right, 40};
    DrawTextA(hdc, title, -1, &tr, DT_CENTER|DT_VCENTER);
    
    EndPaint(hwnd, &ps);
}

void DrawRoundBtn(DRAWITEMSTRUCT* dis){
    BtnInfo* bi=FindBtn(dis->hwndItem);
    if(!bi)return;
    HDC hdc=dis->hDC;
    RECT rc=dis->rcItem;
    bool pressed=(dis->itemState&ODS_SELECTED)!=0;
    
    // Tinh toan mau sac khi nhan phim
    COLORREF clr = pressed ? RGB(
        max(0,(int)(GetRValue(bi->color)-30)),
        max(0,(int)(GetGValue(bi->color)-30)),
        max(0,(int)(GetBValue(bi->color)-30))
    ) : bi->color;

    // Do bong mem cho nut (Shadow)
    if(!pressed){
        RECT shadow=rc; shadow.top+=2; shadow.left+=1; shadow.right-=1; shadow.bottom-=1;
        HBRUSH shb=CreateSolidBrush(RGB(180,180,180));
        HBRUSH oldb=(HBRUSH)SelectObject(hdc,shb);
        HPEN oldp=(HPEN)SelectObject(hdc,GetStockObject(NULL_PEN));
        RoundRect(hdc,shadow.left,shadow.top,shadow.right,shadow.bottom,22,22);
        SelectObject(hdc,oldb); SelectObject(hdc,oldp);
        DeleteObject(shb);
    }

    // Ve khoi nut chinh bo tron
    HBRUSH br=CreateSolidBrush(clr);
    HPEN pen=CreatePen(PS_SOLID, 1, clr);
    SelectObject(hdc,br);
    SelectObject(hdc,pen);
int bottomOffset = pressed ? 0 : 2; // Hieu ung lun xuong
    RoundRect(hdc, rc.left, rc.top, rc.right, rc.bottom - bottomOffset, 22, 22);
    DeleteObject(br);
    DeleteObject(pen);
    
    // Ve chu
    char txt[128]={0};GetWindowTextA(dis->hwndItem,txt,128);
    SetBkMode(hdc,TRANSPARENT);
    SetTextColor(hdc,RGB(255,255,255));
    SelectObject(hdc,hFBold);
    
    RECT tr = rc;
    if(pressed) { tr.top += 1; tr.bottom += 1; }
    else { tr.bottom -= 2; }
    DrawTextA(hdc,txt,-1,&tr,DT_CENTER|DT_VCENTER|DT_SINGLELINE);
}

void UpdateKeyStatus(HWND hKeyEdit, HWND hFormatCombo, HWND hStatus, COLORREF bg){
    string key=GetET(hKeyEdit);
    int fmt = SendMessage(hFormatCombo, CB_GETCURSEL, 0, 0);
    string st=checkKey(key, fmt);
    if(st=="OK"){
        SetET(hStatus, fmt == 0 ? "  Khoa Text hop le (8 ky tu)" : "  Khoa Hex hop le (16 ky tu)");
    } else {
        SetET(hStatus,"  "+st);
    }
    InvalidateRect(hStatus,NULL,TRUE);
    UpdateWindow(hStatus);
}

void AutoDetectKey(HWND hKeyEdit, HWND hFormatCombo, HWND hStatus, string loaded) {
    while(!loaded.empty() && (loaded.back()=='\r' || loaded.back()=='\n' || loaded.back()=='\0')) loaded.pop_back();
    
    bool isHex = true;
    for(char c : loaded) if(!isxdigit(c)) isHex = false;
    
    if(loaded.size() == 16 && isHex) {
        SendMessage(hFormatCombo, CB_SETCURSEL, 1, 0); 
        SetET(hKeyEdit, loaded);
    } else {
        SendMessage(hFormatCombo, CB_SETCURSEL, 0, 0); 
        if(loaded.size() > 8) loaded = loaded.substr(0,8);
        SetET(hKeyEdit, loaded);
    }
    UpdateKeyStatus(hKeyEdit, hFormatCombo, hStatus, CLR_ENC_BG);
}

