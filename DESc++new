static uint32_t Crc32(const string& data){
    uint32_t crc = 0xFFFFFFFFu;
    for(unsigned char b : data){
        crc ^= b;
        for(int k=0;k<8;k++) crc = (crc & 1) ? (crc>>1) ^ 0xEDB88320u : (crc>>1);
    }
    return crc ^ 0xFFFFFFFFu;
}
static void PutU16(string& s, uint16_t v){ s += (char)(v & 0xFF); s += (char)((v>>8)&0xFF); }
static void PutU32(string& s, uint32_t v){ for(int i=0;i<4;i++){ s += (char)((v>>(8*i))&0xFF); } }

struct ZEntry{ string name; string data; };

static string BuildZip(const vector<ZEntry>& entries){
    string out;
    vector<uint32_t> offsets;
    for(const auto& e : entries){
        offsets.push_back((uint32_t)out.size());
        uint32_t crc = Crc32(e.data);
        out += string("PK\x03\x04");
        PutU16(out, 20);
        PutU16(out, 0);
        PutU16(out, 0);
        PutU16(out, 0); PutU16(out, 0);
        PutU32(out, crc);
        PutU32(out, (uint32_t)e.data.size());
        PutU32(out, (uint32_t)e.data.size());
        PutU16(out, (uint16_t)e.name.size());
        PutU16(out, 0);
        out += e.name;
        out += e.data;
    }
    uint32_t cdStart = (uint32_t)out.size();
    for(size_t i=0;i<entries.size();i++){
        const auto& e = entries[i];
        uint32_t crc = Crc32(e.data);
out += string("PK\x01\x02");
        PutU16(out, 20); PutU16(out, 20);
        PutU16(out, 0); PutU16(out, 0);
        PutU16(out, 0); PutU16(out, 0);
        PutU32(out, crc);
        PutU32(out, (uint32_t)e.data.size());
        PutU32(out, (uint32_t)e.data.size());
        PutU16(out, (uint16_t)e.name.size());
        PutU16(out, 0); PutU16(out, 0); PutU16(out, 0); PutU16(out, 0);
        PutU32(out, 0);
        PutU32(out, offsets[i]);
        out += e.name;
    }
    uint32_t cdSize = (uint32_t)out.size() - cdStart;
    out += string("PK\x05\x06");
    PutU16(out, 0); PutU16(out, 0);
    PutU16(out, (uint16_t)entries.size());
    PutU16(out, (uint16_t)entries.size());
    PutU32(out, cdSize);
    PutU32(out, cdStart);
    PutU16(out, 0);
    return out;
}

static string BuildDocx(const string& content){
    string safe; safe.reserve(content.size());
    for(char c : content){
        if(c=='&') safe += "&amp;";
        else if(c=='<') safe += "&lt;";
        else if(c=='>') safe += "&gt;";
        else safe += c;
    }
    string body;
    size_t start=0;
    for(size_t i=0;i<=safe.size();i++){
        if(i==safe.size() || safe[i]=='\n'){
            string line = safe.substr(start, i-start);
            body += "<w:p><w:r><w:t xml:space=\"preserve\">" + line + "</w:t></w:r></w:p>\n";
            start = i+1;
        }
    }
    string docXml = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n"
        "<w:document xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">\n"
        "<w:body>\n" + body + "</w:body>\n</w:document>";
    string relsXml = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n"
        "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">\n"
        "<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"word/document.xml\"/>\n"
        "</Relationships>";
    string ctXml = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n"
        "<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">\n"
        "<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>\n"
        "<Default Extension=\"xml\" ContentType=\"application/xml\"/>\n"
        "<Override PartName=\"/word/document.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml\"/>\n"
        "</Types>";
    vector<ZEntry> entries = {
        {"[Content_Types].xml", ctXml},
        {"_rels/.rels", relsXml},
        {"word/document.xml", docXml}
    };
    return BuildZip(entries);
}

static string BuildPdf(const string& content){
    vector<string> lines; string cur;
    for(size_t i=0;i<=content.size();i++){
        if(i==content.size() || content[i]=='\n'){ lines.push_back(cur); cur.clear(); }
        else cur += content[i];
    }
    int lpp = 45;
int pageCount = max(1, (int)((lines.size() + lpp - 1) / lpp));

    string out = "%PDF-1.4\n%";
    out += (char)0xE2; out += (char)0xE3; out += (char)0xCF; out += (char)0xD3; out += "\n";

    vector<long> off(2 + 2*pageCount + 1, 0);
    long pos = (long)out.size();

    auto writeObj = [&](int objNo, const string& body){
        off[objNo-1] = pos;
        out += body;
        pos = (long)out.size();
    };

    writeObj(1, "1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n");

    int fpObj = 3;
    int fcObj = fpObj + pageCount;

    string kids = "[";
    for(int i=0;i<pageCount;i++) kids += to_string(fpObj+i) + " 0 R ";
    kids += "]";
    writeObj(2, "2 0 obj\n<< /Type /Pages /Kids " + kids + " /Count " + to_string(pageCount) + " >>\nendobj\n");

    for(int p=0;p<pageCount;p++){
        int o = fpObj + p, c = fcObj + p;
        writeObj(o, to_string(o) + " 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Contents " + to_string(c) + " 0 R /Resources << /Font << /F1 << /Type /Font /Subtype /Type1 /BaseFont /Helvetica >> >> >> >>\nendobj\n");
    }
    for(int p=0;p<pageCount;p++){
        int o = fcObj + p;
        string st = "BT\n/F1 12 Tf\n14 TL\n50 810 Td\n";
        int lo = p*lpp, hi = (int)min((size_t)(p*lpp+lpp), lines.size());
        for(int li=lo; li<hi; li++){
            string ln = lines[li];
            string safe;
            for(char c : ln){
                if(c=='\\'||c=='('||c==')') safe += '\\';
                safe += c;
            }
            st += "(" + safe + ") Tj\nT*\n";
        }
        st += "ET\n";
        string s = to_string(o) + " 0 obj\n<< /Length " + to_string(st.size()) + " >>\nstream\n";
        writeObj(o, s + st + "\nendstream\nendobj\n");
    }
    long xr = pos;
    int total = fcObj + pageCount - 1;
    string x = "xref\n0 " + to_string(total+1) + "\n0000000000 65535 f \n";
    for(int i=0;i<total;i++){
        char buf[16]; snprintf(buf, sizeof(buf), "%010ld 00000 n \n", off[i]);
        x += buf;
    }
    x += "trailer\n<< /Size " + to_string(total+1) + " /Root 1 0 R >>\nstartxref\n" + to_string(xr) + "\n%%EOF\n";
    out += x;
    return out;
}

static string ExtractTextFromPdf(const string& raw){
    if(raw.size() < 4 || raw.substr(0,4) != "%PDF") return raw;
    string result;
    std::regex re("\\(([^)]*)\\)\\s*Tj");
    auto begin = std::sregex_iterator(raw.begin(), raw.end(), re);
    auto end = std::sregex_iterator();
    bool found=false;
    for(auto it=begin; it!=end; ++it){
        string g = (*it)[1].str();
        string unesc;
        for(size_t i=0;i<g.size();i++){
            if(g[i]=='\\' && i+1<g.size()){ unesc += g[i+1]; i++; }
            else unesc += g[i];
        }
        result += unesc + "\n";
        found = true;
    }
    if(!found) return raw;
    if(!result.empty() && result.back()=='\n') result.pop_back();
    return result;
}

static string ExtractTextFromDocx(const string& data){
if(data.size() < 4 || !(data[0]=='P'&&data[1]=='K'&&data[2]==0x03&&data[3]==0x04))
        return data;
    size_t pos = 0;
    while(pos + 30 <= data.size()){
        if(!(data[pos]=='P'&&data[pos+1]=='K'&&data[pos+2]==0x03&&data[pos+3]==0x04)) break;
        uint16_t method = (uint8_t)data[pos+8] | ((uint8_t)data[pos+9]<<8);
        uint32_t csize = (uint8_t)data[pos+18] | ((uint8_t)data[pos+19]<<8) | ((uint8_t)data[pos+20]<<16) | ((uint8_t)data[pos+21]<<24);
        uint16_t nameLen = (uint8_t)data[pos+26] | ((uint8_t)data[pos+27]<<8);
        uint16_t extraLen = (uint8_t)data[pos+28] | ((uint8_t)data[pos+29]<<8);
        string name = data.substr(pos+30, nameLen);
        size_t dataStart = pos + 30 + nameLen + extraLen;
        if(name == "word/document.xml"){
            if(method != 0){
                return "[Khong the doc noi dung: file .docx nay duoc nen (deflate).\nVui long mo bang Word va luu lai dang .txt, hoac dung file .docx do chinh chuong trinh nay tao.]";
            }
            string xml = data.substr(dataStart, csize);
            string out; bool inTag=false;
            for(size_t i=0;i<xml.size();i++){
                if(xml.compare(i,6,"</w:p>")==0){ out += '\n'; i+=5; continue; }
                char c = xml[i];
                if(c=='<') inTag=true;
                else if(c=='>') inTag=false;
                else if(!inTag) out += c;
            }
            string r2;
            for(size_t i=0;i<out.size();i++){
                if(out.compare(i,5,"&amp;")==0){ r2+='&'; i+=4; }
                else if(out.compare(i,4,"&lt;")==0){ r2+='<'; i+=3; }
                else if(out.compare(i,4,"&gt;")==0){ r2+='>'; i+=3; }
                else r2 += out[i];
            }
            return r2;
        }
        dataStart += csize;
        pos = dataStart;
    }
    return "[Khong tim thay noi dung van ban trong file .docx]";
}

static wstring GetExtW(const wstring& path){
    size_t dot = path.find_last_of(L'.');
    if(dot==wstring::npos) return L"";
    wstring ext = path.substr(dot);
    for(auto& c : ext) c = (wchar_t)tolower((wchar_t)c);
    return ext;
}

static bool WriteContentAuto(const wstring& path, const string& content){
    wstring ext = GetExtW(path);
    if(ext == L".docx") return WriteF(path, BuildDocx(content));
    if(ext == L".pdf")  return WriteF(path, BuildPdf(content));
    return WriteF(path, content);
}

static string ReadContentAuto(const wstring& path){
    string raw = ReadF(path);
    wstring ext = GetExtW(path);
    if(ext == L".docx") return ExtractTextFromDocx(raw);
    if(ext == L".pdf")  return ExtractTextFromPdf(raw);
    return raw;
}

